{
  "name": "rezzy-outreach",
  "version": "1.0.0",
  "description": "WhatsApp Outreach Tool for Sharjah Salons",
  "main": "main.js",
  "author": "Francis",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.rezzy.outreach",
    "productName": "Rezzy Outreach",
    "copyright": "Copyright © 2026 Francis",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Rezzy Outreach"
    },
    "npmRebuild": true,
    "asar": true,
    "files": [
      "**/*",
      "!dist/*"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1"
  }
}